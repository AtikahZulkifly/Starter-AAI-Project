# Copy to .env and fill in real values. .env is gitignored.
# SQLite file, relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Signs the session cookie. Generate one with: openssl rand -base64 32
# (or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=replace-me-with-a-random-secret
